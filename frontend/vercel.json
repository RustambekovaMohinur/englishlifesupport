{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://englishlifesupport-kot4.onrender.com/api/$1"
    },
    {
      "source": "/wordlists/(.*)",
      "destination": "https://englishlifesupport-kot4.onrender.com/wordlists/$1"
    },
    {
      "source": "/wordlists",
      "destination": "https://englishlifesupport-kot4.onrender.com/wordlists"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

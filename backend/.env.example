# PostgreSQL connection
# Sync URL is used by Alembic, async URL is used by the FastAPI app.
DATABASE_URL=postgresql+psycopg2://englishlife:changeme@localhost:5432/englishlife
ASYNC_DATABASE_URL=postgresql+asyncpg://englishlife:changeme@localhost:5432/englishlife

# JWT
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# App
ENVIRONMENT=development
BOOTSTRAP_TEACHER_EMAIL=teacher@englishlife.uz
BOOTSTRAP_TEACHER_PASSWORD=ChangeMe123!
BOOTSTRAP_TEACHER_NAME=English Life Teacher

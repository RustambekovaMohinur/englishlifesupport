# ==============================================================================
# Database (Neon PostgreSQL)
# ==============================================================================
# Standard connection string provided by Neon.tech or cloud provider:
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional explicit async URL (if omitted, the backend auto-generates asyncpg driver):
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# Security & JWT
# ==============================================================================
JWT_SECRET_KEY=generate_a_64_character_random_hex_or_alphanumeric_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# ==============================================================================
# CORS Configuration
# ==============================================================================
CORS_ORIGINS=https://englishlifesupport.vercel.app,http://localhost:5173

# ==============================================================================
# Backblaze B2 Object Storage
# ==============================================================================
STORAGE_BACKEND=b2
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_BUCKET_NAME=english-life-files
B2_REGION=us-east-005
B2_KEY_ID=your_backblaze_key_id
B2_APPLICATION_KEY=your_backblaze_application_key

# ==============================================================================
# Google Gemini AI Service
# ==============================================================================
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# Application & Initial Bootstrap
# ==============================================================================
ENVIRONMENT=production
BOOTSTRAP_TEACHER_EMAIL=teacher@englishlife.uz
BOOTSTRAP_TEACHER_PASSWORD=ChangeMe123!
BOOTSTRAP_TEACHER_NAME=English Life Teacher
